\pard\sa200\sl276\slmult1\f1 Question :- Implement a doubly linked list for managing a music playlist with forward and backward navigation.\par
Code :-\par

\pard\sl276\slmult1\b0\fs22 #include <iostream>\par
using namespace std;\par
\par
struct Node \{\par
    string song;\par
    Node *prev, *next;\par
\};\par
\par
int main() \{\par
    Node *song1=new Node\{"Song A",NULL,NULL\};\par
    Node *song2=new Node\{"Song B",NULL,NULL\};\par
    Node *song3=new Node\{"Song C",NULL,NULL\};\par
\par
    song1->next=song2;\par
    song2->prev=song1;\par
\par
    song2->next=song3;\par
    song3->prev=song2;\par
\par
    cout<<"Forward Playlist:\\n";\par
    Node *temp=song1;\par
\par
    while(temp!= NULL) \{\par
        cout<<temp->song<<endl;\par
        temp=temp->next;\par
    \}\par
\par
    cout<<"\\nBackward Playlist:\\n";\par
    temp=song3;\par
\par
    while(temp!=NULL) \{\par
        cout<<temp->song<<endl;\par
        temp=temp->prev;\par
    \}\par
    return 0;\par
\}\par
\par
\b\fs32 Output :-\par

