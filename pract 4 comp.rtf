\pard\sa200\sl276\slmult1\f1 Question :- Implement a circular linked list to simulate round robin scheduling for tournament teams. \par
Code :- \par

\pard\sl276\slmult1\fs22 #include <iostream>\par
using namespace std;\par
\par
struct Team\par
\{\par
    int id;\par
    char name[50];\par
    Team *next;\par
\};\par
Team *head = NULL;\par
Team *current = NULL;\par
void addTeam()\par
\{\par
    Team *newTeam, *temp;\par
    newTeam = new Team;\par
    cout << "\\nEnter Team ID: ";\par
    cin >> newTeam->id;\par
    cout << "Enter Team Name: ";\par
    cin >> newTeam->name;\par
    newTeam->next = NULL;\par
    if (head == NULL)\par
    \{\par
        head = newTeam;\par
        newTeam->next = head;\par
        current = head;\par
    \}\par
    else\par
    \{\par
        temp = head;\par
        while (temp->next != head)\par
        \{\par
            temp = temp->next;\par
        \}\par
        temp->next = newTeam;\par
        newTeam->next = head;\par
    \}\par
    cout << "Team added successfully!\\n";\par
\}\par
void displayTeams()\par
\{\par
    Team *temp;\par
    if (head == NULL)\par
    \{\par
        cout << "\\nNo teams available!\\n";\par
        return;\par
    \}\par
    temp = head;\par
    cout << "\\n----- Tournament Teams -----\\n";\par
    do\par
    \{\par
        cout << "Team ID: " << temp->id\par
             << "  Team Name: " << temp->name << endl;\par
        temp = temp->next;\par
    \} while (temp != head);\par
\}\par
void nextTeam()\par
\{\par
    if (current == NULL)\par
    \{\par
        cout << "\\nNo teams available!\\n";\par
        return;\par
    \}\par
    current = current->next;\par
    cout << "\\nCurrent Team: "\par
         << current->name << endl;\par
\}\par
void roundRobin()\par
\{\par
    Team *first;\par
    Team *second;\par
    if (head == NULL)\par
    \{\par
        cout << "\\nNo teams available!\\n";\par
        return;\par
    \}\par
    first = head;\par
    cout << "\\n===== ROUND ROBIN SCHEDULE =====\\n";\par
    do\par
    \{\par
        second = first->next;\par
        while (second != head)\par
        \{\par
            cout << first->name << " vs " << second->name << endl;\par
            second = second->next;\par
        \}\par
        first = first->next;\par
    \} while (first != head);\par
\}\par
int main()\par
\{\par
    int choice;\par
    do\par
    \{\par
        cout << "\\n===== TOURNAMENT ROUND ROBIN =====\\n";\par
        cout << "1. Add Team\\n";\par
        cout << "2. Display Teams\\n";\par
        cout << "3. Next Team\\n";\par
        cout << "4. Generate Round Robin Schedule\\n";\par
        cout << "5. Exit\\n";\par
        cout << "Enter your choice: ";\par
        cin >> choice;\par
        switch (choice)\par
        \{\par
            case 1:\par
                addTeam();\par
                break;\par
            case 2:\par
                displayTeams();\par
                break;\par
            case 3:\par
                nextTeam();\par
                break;\par
            case 4:\par
                roundRobin();\par
                break;\par
            case 5:\par
                cout << "\\nProgram ended.\\n";\par
                break;\par
            default:\par
                cout << "\\nInvalid choice!\\n";\par
        \}\par
    \} while (choice != 5);\par
    return 0;\par
\}\fs32\par

