\par \hich\af37\dbch\af31505\loch\f37         head = temp->next;
\par \hich\af37\dbch\af31505\loch\f37     else
\par \hich\af37\dbch\af31505\loch\f37         prev->next = temp->next;
\par \hich\af37\dbch\af31505\loch\f37     delete temp;
\par \hich\af37\dbch\af31505\loch\f37     cout << "Employee Dele\hich\af37\dbch\af31505\loch\f37 ted!";
