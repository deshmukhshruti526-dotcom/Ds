\par \hich\af37\dbch\af31505\loch\f37             return;
\par \hich\af37\dbch\af31505\loch\f37         \}
\par \hich\af37\dbch\af31505\loch\f37         temp = temp->next;
\par \hich\af37\dbch\af31505\loch\f37     \}
\par \hich\af37\dbch\af31505\loch\f37     cou\hich\af37\dbch\af31505\loch\f37 t << "Employee Not Found!";
