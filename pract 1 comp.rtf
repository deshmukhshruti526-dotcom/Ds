\par \hich\af37\dbch\af31505\loch\f37         cout << "\\nName: " << temp->name << endl;
\par \hich\af37\dbch\af31505\loch\f37         temp = temp->next;
\par \hich\af37\dbch\af31505\loch\f37     \}
\par \}
\par \hich\af37\dbch\af31505\loch\f37 void search()
\par \{
\par \hich\af37\dbch\af31505\loch\f37     int id;
\par \hich\af37\dbch\af31505\loch\f37     cout << "Enter ID to search: ";
