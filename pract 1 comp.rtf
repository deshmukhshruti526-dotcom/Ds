\par \hich\af37\dbch\af31505\loch\f37 void deleteEmployee()
\par \{
\par \hich\af37\dbch\af31505\loch\f37     int id;
\par \hich\af37\dbch\af31505\loch\f37     cout << "Enter ID to delete: ";
\par \hich\af37\dbch\af31505\loch\f37     cin >> id;
\par \hich\af37\dbch\af31505\loch\f37     Employee *temp = head;
\par \hich\af37\dbch\af31505\loch\f37     Employee *prev = NULL;
\par \hich\af37\dbch\af31505\loch\f37     while (temp != NULL && temp->id != id)
