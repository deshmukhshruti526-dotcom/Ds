    \}\par
\}\par
\par
void display() \{\par
    int i;\par
    printf("Browser History:\\n");\par
    for (i = top; i >= 0; i--)\par
        printf("%s\\n", stack[i]);\par
\}\par
\par
int main() \{\par
    push("Google");\par
    push("YouTube");\par
    push("Wikipedia");\par
    push("GitHub");\par
\par
    display();\par
\par
    printf("\\nBacktracking:\\n");\par
    pop();\par
    pop();\par
\par
    return 0;\par
