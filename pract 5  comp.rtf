\pard\sl276\slmult1\fs22 #include <iostream>\par
#include <string>\par
\par
#define MAX 100\par
\par
char stack[MAX][100];\par
int top = -1;\par
\par
void push(char page[]) \{\par
    if (top == MAX - 1)\par
        printf("Stack Overflow\\n");\par
    else \{\par
        top++;\par
        strcpy(stack[top], page);\par
    \}\par
\}\par
\par
void pop() \{\par
